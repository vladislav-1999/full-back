# --- Postgres (docker-compose) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Приложение ---
DATABASE_URL=
JWT_SECRET=
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Разрешённые origin через запятую
CORS_ORIGIN=http://localhost:3000

# Сколько прокси перед приложением. Локально 0, на Render 3 (измерено).
# НИКОГДА не ставить true — это позволяет подделать X-Forwarded-For и обойти лимиты.
TRUST_PROXY=0

# Лимиты запросов: общий за 15 мин / вход за 15 мин / регистрации за час
RATE_LIMIT_API=300
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=10